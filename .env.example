# Ollama (local LLM, recommended)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
RAG_EMBED_MODEL=embeddinggemma
RAG_MODEL=gemma2:2b
RAG_MIN_SCORE=0.20

# HuggingFace fallback (optional)
HF_TOKEN=
HF_MODEL=gpt2

# Set to 1 only for limited sentence-generation demos without an LLM.
# This fallback does not evaluate translations or free writing.
AI_LOCAL_FALLBACK=0
